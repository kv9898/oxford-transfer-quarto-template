{
  "Document metadata": {
    "prefix": "document",
    "body": [
      "---",
      "title: \"${1:Project title}\"",
      "author: \"${2:Candidate name}\"",
      "date: \"${3:Month Year}\"",
      "abstract: |",
      "  ${4:A short abstract for the report.}",
      "keywords: [${5:keyword one}, ${6:keyword two}]",
      "format:",
      "  oxford-transfer-pdf:",
      "    supervisor: \"${7:Professor First Supervisor}\"",
      "    college: \"${8:College name}\"",
      "    department: \"${9:Department of Politics and International Relations}\"",
      "    status: \"${10:Transfer of Status}\"",
      "    number-sections: true",
      "---",
      "",
      "$0"
    ],
    "description": "Insert front matter for an Oxford Transfer of Status report."
  },
  "Layout options": {
    "prefix": "layout",
    "body": [
      "format:",
      "  oxford-transfer-pdf:",
      "    running-header: ${1|true,false|}",
      "    minimal-footer: ${2|false,true|}",
      "    header-left: \"${3:University of Oxford}\"",
      "    header-right: \"${4:Transfer of Status}\"",
      "    footer-left: \"${5}\"",
      "    supervisor-label: \"${6:Supervisor}\"",
      "    lof: ${7|true,false|}",
      "    lot: ${8|true,false|}",
      "    lol: ${9|false,true|}",
      "    listings: ${10|false,true|}"
    ],
    "description": "Insert configurable header, footer, and content-list options for the Oxford Transfer PDF format."
  },
  "Crest path": {
    "prefix": "crest",
    "body": [
      "format:",
      "  oxford-transfer-pdf:",
      "    crest: ${1:_extensions/oxford-transfer/figures/beltcrest.pdf}"
    ],
    "description": "Insert the path to an authorised local copy of the Oxford crest."
  }
}
